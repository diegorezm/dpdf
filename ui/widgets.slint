import { Theme } from "theme.slint";

export component Panel inherits Rectangle {
    background: Theme.raised;
    border-radius: Theme.radius + 2px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000045;
}

export component Field inherits TextInput {
    color: Theme.text;
    font-size: Theme.font-size;
    selection-background-color: Theme.selection;
    vertical-alignment: center;
    single-line: true;
}

// Quiet text button, used in the header and popups.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <length> font-size: Theme.font-size;
    callback clicked();

    min-width: label.preferred-width + 14px;
    min-height: 26px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;

    label := Text {
        text: root.text;
        color: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-muted;
        font-size: root.font-size;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Bordered button for settings and dialogs.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();

    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: Theme.radius;
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.border;
    background: root.primary ? Theme.accent : touch.has-hover ? Theme.hover : transparent;

    label := Text {
        text: root.text;
        color: root.primary ? Theme.background : Theme.text;
        font-size: Theme.font-size;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 34px;
    height: 20px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.border;

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: parent.height - 6px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? Theme.background : Theme.text-muted;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

// Dropdown: shows the current value; clicking lists the options.
export component Select inherits Rectangle {
    in property <[string]> options;
    in property <string> value;
    callback selected(string);

    width: 180px;
    height: 30px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: "⌄";
            color: Theme.text-muted;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        y: root.height + 4px;
        width: root.width;

        Panel {
            VerticalLayout {
                padding: 4px;

                for option in root.options: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius - 2px;
                    background: item.has-hover ? Theme.hover : transparent;

                    Text {
                        x: 8px;
                        text: option;
                        color: option == root.value ? Theme.accent : Theme.text;
                        font-size: Theme.font-size;
                    }

                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected(option);
                        }
                    }
                }
            }
        }
    }
}

// A keyboard shortcut label.
export component Kbd inherits Rectangle {
    in property <string> text;

    width: label.preferred-width + 10px;
    height: 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;

    label := Text {
        text: root.text;
        color: Theme.text-muted;
        font-size: Theme.font-size-small;
        font-family: "Consolas";
    }
}

// Line icons drawn as SVG paths on a 24x24 grid, so they don't depend on
// which symbol fonts are installed.
export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.text-muted;

    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    commands: root.name == "general" ? "M4 6h16 M4 12h16 M4 18h16 M9 4v4 M15 10v4 M7 16v4"
        : root.name == "reading" ? "M4 5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z M4 19V5 M8 7h8"
        : root.name == "theme" ? "M12 3a9 9 0 1 0 0.01 0z M12 3v18 M12 7h4 M12 11h6 M12 15h5"
        : root.name == "appearance" ? "M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z M12 9a3 3 0 1 0 0.01 0z"
        : root.name == "keys" ? "M3 6h18v12H3z M6.5 10h1 M10.5 10h1 M14.5 10h1 M7 14h10"
        : root.name == "file" ? "M6 2h9l5 5v15H6z M14 2v6h6 M9 13h6 M9 17h6"
        : root.name == "about" ? "M12 3a9 9 0 1 0 0.01 0z M12 11v6 M12 7.5v0.5"
        : root.name == "search" ? "M11 4a7 7 0 1 0 0.01 0z M20 20l-4-4"
        : root.name == "sidebar" ? "M3 4h18v16H3z M9 4v16"
        : root.name == "home" ? "M3 11l9-7 9 7 M5 9.5V20h5v-6h4v6h5V9.5"
        : root.name == "plus" ? "M12 5v14 M5 12h14"
        : root.name == "session" ? "M12 3l9 5-9 5-9-5z M3 13l9 5 9-5"
        : root.name == "pdf" ? "M6 2h9l5 5v15H6z M14 2v6h6"
        : root.name == "fit-width" ? "M3 12h18 M7 8l-4 4 4 4 M17 8l4 4-4 4"
        : root.name == "fit-page" ? "M6 3h12v18H6z"
        : root.name == "zoom-in" ? "M11 5a6 6 0 1 0 0.01 0z M8 11h6 M11 8v6 M20 20l-4.5-4.5"
        : root.name == "zoom-out" ? "M11 5a6 6 0 1 0 0.01 0z M8 11h6 M20 20l-4.5-4.5"
        : root.name == "settings" ? "M12 9a3 3 0 1 0 0.01 0z M12 2v3 M12 19v3 M2 12h3 M19 12h3 M5 5l2 2 M17 17l2 2 M5 19l2-2 M17 7l2-2"
        : root.name == "close" ? "M6 6l12 12 M18 6L6 18"
        : "";
}


// Header icon button; its name and shortcut appear below it on hover.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <string> shortcut;
    in property <bool> active;
    callback clicked();

    width: 30px;
    height: 28px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;

    Icon {
        name: root.icon;
        color: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // Waits a moment so passing the mouse over the header stays quiet.
    property <bool> show-tip: false;
    Timer {
        interval: 400ms;
        running: touch.has-hover && !root.show-tip;
        triggered => {
            root.show-tip = true;
        }
    }
    property <bool> hovered: touch.has-hover;
    changed hovered => {
        if !self.hovered {
            self.show-tip = false;
        }
    }

    if root.show-tip && touch.has-hover: Rectangle {
        y: root.height + 6px;
        // Right-aligned: the header's buttons sit at the window's right edge.
        x: root.width - self.width;
        width: tip-row.preferred-width + 16px;
        height: 26px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.raised;

        tip-row := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            Text {
                text: root.tip;
                color: Theme.text;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
            }
            if root.shortcut != "": Text {
                text: root.shortcut;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                font-family: "Consolas";
                vertical-alignment: center;
            }
        }
    }
}
