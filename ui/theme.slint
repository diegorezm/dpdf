// Embedded only for the wordmark; the interface uses the system font.
import "fonts/IMFellEnglish-Regular.ttf";

// Design tokens. Colors are set from Rust from the active theme file;
// the values here are only the fallback before that happens.
export global Theme {
    in-out property <color> background: #15120e;
    in-out property <color> surface: #1b1713;
    in-out property <color> raised: #241f19;
    in-out property <color> border: #2f2921;
    in-out property <color> text: #e8dfcc;
    in-out property <color> text-muted: #9c907b;
    in-out property <color> accent: #d65a40;
    in-out property <color> hover: #e8dfcc0d;
    in-out property <color> selection: #d65a4055;
    in-out property <color> match: #d6a24055;
    in-out property <color> match-current: #d65a40aa;

    // Layout tokens, set from config.toml (`density`, `corners`,
    // `thumbnail_size`).
    in-out property <length> spacing: 12px;
    in-out property <length> radius: 6px;
    in-out property <length> header-height: 40px;
    in-out property <length> sidebar-width: 180px;
    // Interface font, set from config.toml (`font`, `font_size`).
    in-out property <string> font-family: "Segoe UI Variable Text";
    in-out property <length> font-size: 14px;
    out property <string> display-font: "IM FELL English";
    out property <length> font-size-small: root.font-size - 2px;
    out property <length> font-size-large: root.font-size + 2px;
}
