// Design tokens. Colors are set from Rust from the active theme file;
// the values here are only the fallback before that happens.
export global Theme {
    in-out property <color> background: #121316;
    in-out property <color> surface: #17181c;
    in-out property <color> raised: #1d1f24;
    in-out property <color> border: #24262b;
    in-out property <color> text: #d7d8dc;
    in-out property <color> text-muted: #6c6f78;
    in-out property <color> accent: #8fa8ff;
    in-out property <color> hover: #ffffff0d;
    in-out property <color> selection: #5b8cff55;
    in-out property <color> match: #f5c54255;
    in-out property <color> match-current: #f59b2a99;

    out property <length> spacing: 12px;
    out property <length> radius: 6px;
    out property <length> header-height: 40px;
    out property <length> sidebar-width: 180px;
    out property <length> font-size: 13px;
    out property <length> font-size-small: 11px;
    out property <length> font-size-large: 15px;
}
