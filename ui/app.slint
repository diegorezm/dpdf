import { Theme } from "theme.slint";
import { PageView, ThumbView, RecentItem, TabItem, PaletteItem, KeyRow, ThemeCard, SideItem, NoteFilter, SubjectItem, HighlightRow } from "structs.slint";
import { Panel, Field, TextButton, Icon, IconButton, Toggle, Button } from "widgets.slint";
import { Sidebar, ReadingArea, StartScreen, TabBar } from "reader.slint";
import { Palette } from "palette.slint";
import { SettingsView } from "settings.slint";

export { Theme }
export { Highlight, Mark, PageView, ThumbView, RecentItem, TabItem, PaletteItem, KeyRow, ThemeCard, SideItem, NoteFilter, SubjectItem, HighlightRow } from "structs.slint";

export component AppWindow inherits Window {
    title: root.page-count > 0 ? "\{root.document-title} — Leme" : "Leme";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    // Chrome.
    in-out property <bool> sidebar-visible: true;
    // Show a header button to reopen the sidebar while it's closed.
    in property <bool> sidebar-button: true;
    in property <bool> fullscreen;
    in property <bool> focus-mode;
    in property <[TabItem]> tabs;
    in property <string> document-title;
    in property <int> current-page: 0;
    in property <int> page-count: 0;
    // Notification in the bottom-right corner; Rust clears it.
    in-out property <string> status;
    // Shortcuts shown in header tooltips: fit width, fit page, zoom out,
    // zoom in, settings.
    in property <[string]> header-keys;
    in property <int> zoom-percent: 100;
    // "fit-width", "fit-page", or "custom".
    in property <string> zoom-mode: "fit-width";

    // Pages.
    in property <[PageView]> pages;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> viewport-x;
    in-out property <length> viewport-y;
    out property <length> reader-width: reader.width;
    out property <length> reader-height: reader.height;

    // Thumbnails.
    in property <[ThumbView]> thumbs;
    in property <string> side-panel: "thumbs";
    in property <[SideItem]> side-items;
    in property <[NoteFilter]> note-filters;
    in property <string> outline-progress-text;
    in property <float> outline-progress;
    // The current page's label (e.g. "iv") when it differs from its number.
    in property <string> page-label;
    in property <bool> prompt-secret;
    in property <length> thumbs-content-height;
    in-out property <length> thumbs-viewport-y;

    // Start screen.
    in property <[RecentItem]> recent;
    in property <[RecentItem]> sessions;
    in property <string> session-name: "main";
    in property <bool> home: true;
    in property <[SubjectItem]> subjects;
    in property <string> study-summary;

    // Study time today, shown in the header while `study-timer` is on.
    in property <bool> study-timer;
    in property <bool> study-paused;
    in property <string> study-time: "0m";

    // Overlays: "", "search", "goto", "palette", "prompt", or "note".
    in property <string> prompt-label;
    in-out property <string> prompt-text <=> prompt-input.text;
    in property <string> overlay;
    in-out property <string> search-text <=> search-input.text;
    in property <string> search-status;
    in-out property <string> goto-text <=> goto-input.text;
    in property <[PaletteItem]> palette-items;
    in property <int> palette-selected;
    in-out property <string> palette-query <=> palette.query;
    in property <string> palette-placeholder: @tr("Search commands, tabs, files, themes, or type a page number…");
    in-out property <string> note-text <=> note-input.text;
    in property <string> note-quote;
    // Export sheet: "markdown", "anki", or "csv".
    in property <string> export-format;
    in property <bool> export-by-section;
    in property <string> export-preview;
    in property <string> export-count;
    in property <bool> export-ready;

    // Selection / annotation popup: "", "selection", or "annotation".
    in property <string> popup;
    // A newer release and whether it can install itself (not portable).
    in property <string> update-version;
    in property <bool> update-installs;
    // "install", "skip", or "later".
    callback update-action(string);
    // The note of the annotation under the mouse, shown as a tooltip.
    in property <string> note-tip;
    in property <length> note-tip-x;
    in property <length> note-tip-y;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <[color]> annotation-colors;
    in property <bool> annotation-has-note;

    // Raw key text and modifiers; Rust decides what it means.
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback scrolled();
    callback resized();
    callback thumbs-scrolled();
    callback thumb-clicked(int);
    callback side-panel-clicked(string);
    callback side-item-clicked(int);
    callback side-item-status-clicked(int);
    callback note-filter-clicked(int);
    callback open-recent(int);
    callback open-subject(int);
    callback open-session(int);
    callback prompt-accepted(string);
    // "home", "open", "sessions", or "new-session".
    callback header-action(string);
    callback search-edited(string);
    callback search-step(bool);
    callback goto-accepted(string);
    callback settings-clicked();
    // "in", "out", "fit-width", or "fit-page".
    callback zoom-action(string);
    callback tab-clicked(int);
    callback tab-closed(int);
    // "down", "move", or "up", in reader coordinates.
    callback reader-pointer(string, length, length);
    // "highlight" / "color" (with a color index), "underline", "strike",
    // "note", "copy", or "delete".
    callback popup-action(string, int);
    callback note-saved();
    // "format" (a format name) or "by-section" ("true" / "false").
    callback export-option(string, string);
    callback export-accepted();
    callback palette-edited(string);
    callback palette-moved(int);
    callback palette-accepted();
    callback palette-clicked(int);

    changed viewport-y => { root.scrolled(); }
    changed viewport-x => { root.scrolled(); }
    changed reader-width => { root.resized(); }
    changed reader-height => { root.resized(); }
    changed thumbs-viewport-y => { root.thumbs-scrolled(); }

    // Moves keyboard focus to the open overlay, or back to the reader.
    public function focus-overlay() {
        if root.overlay == "search" {
            search-input.focus();
            search-input.select-all();
        } else if root.overlay == "goto" {
            goto-input.focus();
            goto-input.select-all();
        } else if root.overlay == "palette" {
            palette.focus-input();
        } else if root.overlay == "prompt" {
            prompt-input.focus();
            prompt-input.select-all();
        } else if root.overlay == "note" {
            note-input.focus();
        } else if root.overlay == "export" {
            export-keys.focus();
        } else {
            keys.focus();
        }
    }

    property <bool> chrome: !root.focus-mode && !root.fullscreen;

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }

        VerticalLayout {
            if root.chrome: Rectangle {
                // Above the reader, so tooltips can hang over it.
                z: 1;
                height: Theme.header-height;
                background: Theme.background;

                HorizontalLayout {
                    padding-left: Theme.spacing * 0.75;
                    padding-right: Theme.spacing;
                    spacing: Theme.spacing;

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        // Reopens the closed sidebar.
                        if root.sidebar-button && !root.sidebar-visible && root.chrome && root.page-count > 0: Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 30px;
                            height: 28px;
                            border-radius: Theme.radius;
                            background: sidebar-touch.has-hover ? Theme.hover : transparent;

                            Icon {
                                name: "sidebar";
                                color: sidebar-touch.has-hover ? Theme.text : Theme.text-muted;
                            }

                            sidebar-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.header-action("sidebar");
                                }
                            }
                        }

                        // Current session, like tmux's status line.
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 28px;
                            width: session-row.preferred-width + 16px;
                            border-radius: Theme.radius;
                            background: session-touch.has-hover ? Theme.hover : transparent;

                            session-row := HorizontalLayout {
                                x: 8px;
                                spacing: 6px;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    name: "session";
                                    color: Theme.accent;
                                }
                                Text {
                                    text: root.session-name;
                                    color: Theme.text;
                                    font-size: Theme.font-size;
                                    vertical-alignment: center;
                                }
                            }

                            session-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.header-action("sessions");
                                }
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.border;
                        }

                        // Home.
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 30px;
                            height: 28px;
                            border-radius: Theme.radius;
                            background: root.home ? Theme.surface : home-touch.has-hover ? Theme.hover : transparent;
                            border-width: root.home ? 1px : 0;
                            border-color: Theme.border;

                            Icon {
                                name: "home";
                                color: root.home ? Theme.accent : Theme.text-muted;
                            }

                            home-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.header-action("home");
                                }
                            }
                        }

                        TabBar {
                            horizontal-stretch: 0;
                            tabs: root.tabs;
                            clicked(i) => {
                                root.tab-clicked(i);
                            }
                            closed(i) => {
                                root.tab-closed(i);
                            }
                        }

                        // Open another PDF in a new tab.
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 28px;
                            width: open-row.preferred-width + 20px;
                            border-radius: Theme.radius;
                            background: open-touch.has-hover ? Theme.hover : transparent;

                            open-row := HorizontalLayout {
                                x: 10px;
                                spacing: 6px;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    name: "plus";
                                    color: open-touch.has-hover ? Theme.text : Theme.text-muted;
                                }
                                Text {
                                    text: @tr("Open");
                                    color: open-touch.has-hover ? Theme.text : Theme.text-muted;
                                    font-size: Theme.font-size;
                                    vertical-alignment: center;
                                }
                            }

                            open-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.header-action("open");
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    if root.page-count > 0: HorizontalLayout {
                        spacing: 2px;
                        horizontal-stretch: 0;

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "fit-width";
                            tip: @tr("Fit width");
                            shortcut: root.header-keys[0];
                            active: root.zoom-mode == "fit-width";
                            clicked => {
                                root.zoom-action("fit-width");
                            }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "fit-page";
                            tip: @tr("Fit page");
                            shortcut: root.header-keys[1];
                            active: root.zoom-mode == "fit-page";
                            clicked => {
                                root.zoom-action("fit-page");
                            }
                        }
                        Rectangle {
                            width: Theme.spacing;
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "zoom-out";
                            tip: @tr("Zoom out");
                            shortcut: root.header-keys[2];
                            clicked => {
                                root.zoom-action("out");
                            }
                        }
                        Text {
                            text: "\{root.zoom-percent}%";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 44px;
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "zoom-in";
                            tip: @tr("Zoom in");
                            shortcut: root.header-keys[3];
                            clicked => {
                                root.zoom-action("in");
                            }
                        }
                        Rectangle {
                            width: Theme.spacing;
                        }
                    }
                    if root.study-timer && root.page-count > 0: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 24px;
                        width: timer-text.preferred-width + 16px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: timer-touch.has-hover ? Theme.hover : transparent;

                        timer-text := Text {
                            text: root.study-paused ? "⏸ \{root.study-time}" : "⏱ \{root.study-time}";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                        }

                        timer-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.header-action("study-timer");
                            }
                        }
                    }
                    if root.study-timer && root.page-count > 0: Rectangle {
                        width: Theme.spacing;
                    }
                    Text {
                        text: root.page-count == 0 ? "" : root.page-label != "" ? "\{root.page-label} (\{root.current-page} / \{root.page-count})" : "\{root.current-page} / \{root.page-count}";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "settings";
                        tip: @tr("Settings");
                        shortcut: root.header-keys[4];
                        clicked => {
                            root.settings-clicked();
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                if root.sidebar-visible && root.chrome && root.page-count > 0: Sidebar {
                    thumbs: root.thumbs;
                    current-page: root.current-page - 1;
                    content-height: root.thumbs-content-height;
                    viewport-y <=> root.thumbs-viewport-y;
                    mode: root.side-panel;
                    items: root.side-items;
                    filters: root.note-filters;
                    progress-text: root.outline-progress-text;
                    progress: root.outline-progress;
                    filter-clicked(i) => {
                        root.note-filter-clicked(i);
                    }
                    status-clicked(i) => {
                        root.side-item-status-clicked(i);
                    }
                    clicked(page) => {
                        root.thumb-clicked(page);
                    }
                    mode-clicked(mode) => {
                        root.side-panel-clicked(mode);
                    }
                    item-clicked(i) => {
                        root.side-item-clicked(i);
                    }
                    close-clicked => {
                        root.header-action("sidebar");
                    }
                }

                reader := Rectangle {
                    ReadingArea {
                        pages: root.pages;
                        content-width: root.content-width;
                        content-height: root.content-height;
                        viewport-x <=> root.viewport-x;
                        viewport-y <=> root.viewport-y;
                    }

                    // Text selection, annotation clicks, and Ctrl+wheel zoom.
                    // Plain wheel events fall through to the page strip.
                    if root.page-count > 0: TouchArea {
                        mouse-cursor: text;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {
                                    root.reader-pointer("down", self.mouse-x, self.mouse-y);
                                } else if event.kind == PointerEventKind.up {
                                    root.reader-pointer("up", self.mouse-x, self.mouse-y);
                                }
                            }
                            if event.kind == PointerEventKind.move && !self.pressed {
                                root.reader-pointer("hover", self.mouse-x, self.mouse-y);
                            }
                        }
                        moved => {
                            root.reader-pointer("move", self.mouse-x, self.mouse-y);
                        }
                        double-clicked => {
                            root.reader-pointer("double", self.mouse-x, self.mouse-y);
                        }
                        scroll-event(event) => {
                            if event.modifiers.control {
                                if event.delta-y != 0 {
                                    root.zoom-action(event.delta-y > 0 ? "in" : "out");
                                }
                                return accept;
                            }
                            reject
                        }
                    }

                    if root.page-count == 0: StartScreen {
                        recent: root.recent;
                        sessions: root.sessions;
                        session-name: root.session-name;
                        subjects: root.subjects;
                        study-summary: root.study-summary;
                        open-subject(i) => {
                            root.open-subject(i);
                        }
                        open-recent(i) => {
                            root.open-recent(i);
                        }
                        open-session(i) => {
                            root.open-session(i);
                        }
                        new-session => {
                            root.header-action("new-session");
                        }
                    }

                    // Update available.
                    Panel {
                        visible: root.overlay == "update";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: 380px;
                        height: update-layout.preferred-height;

                        update-layout := VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            Text {
                                text: @tr("Leme {} is available", root.update-version);
                                color: Theme.text;
                                font-size: Theme.font-size;
                            }
                            Text {
                                text: root.update-installs ? @tr("Leme will close, update, and open again.") : @tr("This copy isn't installed, so the release page will open.");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-small;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 4px;

                                TextButton {
                                    text: @tr("Skip this version");
                                    clicked => {
                                        root.update-action("skip");
                                    }
                                }
                                TextButton {
                                    text: @tr("Later");
                                    clicked => {
                                        root.update-action("later");
                                    }
                                }
                                TextButton {
                                    text: root.update-installs ? @tr("Update") : @tr("Open page");
                                    active: true;
                                    clicked => {
                                        root.update-action("install");
                                    }
                                }
                            }
                        }
                    }

                    // Name prompt (new or renamed session).
                    Panel {
                        visible: root.overlay == "prompt";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: 320px;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;

                            Text {
                                text: root.prompt-label;
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                            prompt-input := Field {
                                horizontal-stretch: 1;
                                input-type: root.prompt-secret ? InputType.password : InputType.text;
                                accepted => {
                                    root.prompt-accepted(self.text);
                                }
                            }
                        }
                    }

                    // Note tooltip, below the hovered annotation.
                    if root.note-tip != "" && root.popup == "": Panel {
                        width: min(360px, tip-text.preferred-width + 24px);
                        height: tip-text.preferred-height + 16px;
                        x: max(8px, min(parent.width - self.width - 8px, root.note-tip-x - self.width / 2));
                        y: min(parent.height - self.height - 8px, root.note-tip-y + 6px);

                        tip-text := Text {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            text: root.note-tip;
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                    }

                    // Selection toolbar, or the toolbar of a clicked annotation.
                    if root.popup != "": Panel {
                        x: max(8px, min(parent.width - self.width - 8px, root.popup-x - self.width / 2));
                        y: max(8px, root.popup-y - self.height - 8px);
                        width: popup-row.preferred-width;
                        height: 36px;

                        popup-row := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;

                            for c[i] in root.annotation-colors: Rectangle {
                                width: 30px;

                                Rectangle {
                                    x: 3px;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: c;
                                    border-width: swatch.has-hover ? 2px : 0;
                                    border-color: Theme.text;
                                }

                                // The color's key.
                                Text {
                                    x: 21px;
                                    text: i + 1;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small - 2px;
                                    vertical-alignment: center;
                                }

                                swatch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.popup-action(root.popup == "selection" ? "highlight" : "color", i);
                                    }
                                }
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.border;
                            }
                            TextButton {
                                text: "U̲";
                                clicked => {
                                    root.popup-action("underline", 0);
                                }
                            }
                            TextButton {
                                text: "S̶";
                                clicked => {
                                    root.popup-action("strike", 0);
                                }
                            }
                            TextButton {
                                text: root.popup == "annotation" && root.annotation-has-note ? @tr("Edit note") : @tr("Note");
                                clicked => {
                                    root.popup-action("note", 0);
                                }
                            }
                            TextButton {
                                text: @tr("Copy");
                                clicked => {
                                    root.popup-action("copy", 0);
                                }
                            }
                            if root.popup == "annotation": TextButton {
                                text: @tr("Delete");
                                clicked => {
                                    root.popup-action("delete", 0);
                                }
                            }
                        }
                    }

                    // Search: a small floating bar, top right.
                    Panel {
                        visible: root.overlay == "search";
                        x: parent.width - self.width - Theme.spacing;
                        y: Theme.spacing;
                        width: 320px;
                        height: 40px;

                        FocusScope {
                            // Enter / Shift+Enter step through matches.
                            capture-key-pressed(event) => {
                                if event.text == Key.Return {
                                    root.search-step(!event.modifiers.shift);
                                    return accept;
                                }
                                reject
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: Theme.spacing;

                                search-input := Field {
                                    horizontal-stretch: 1;
                                    edited => {
                                        root.search-edited(self.text);
                                    }
                                }
                                Text {
                                    text: root.search-status;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if search-input.text == "": Text {
                            x: 12px;
                            text: @tr("Search");
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                        }
                    }

                    // Jump to page: centered near the top.
                    Panel {
                        visible: root.overlay == "goto";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: 260px;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;

                            Text {
                                text: @tr("Page or art.");
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                            goto-input := Field {
                                horizontal-stretch: 1;
                                accepted => {
                                    root.goto-accepted(self.text);
                                }
                            }
                            Text {
                                text: "/ \{root.page-count}";
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Export notes: format, colors, and a preview of the file.
                    Panel {
                        visible: root.overlay == "export";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.1;
                        width: min(parent.width - 32px, 560px);
                        height: export-layout.preferred-height;

                        export-keys := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return {
                                    root.export-accepted();
                                    return accept;
                                }
                                reject
                            }

                            export-layout := VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                HorizontalLayout {
                                    Text {
                                        text: @tr("Export notes");
                                        color: Theme.text;
                                        font-size: Theme.font-size-large;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.export-count;
                                        color: Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    for f in [
                                        { id: "markdown", label: "Markdown", detail: @tr("summary by section") },
                                        { id: "anki", label: "Anki", detail: @tr("front · back · tags") },
                                        { id: "csv", label: "CSV", detail: @tr("any app") },
                                    ]: Rectangle {
                                        height: 52px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius;
                                        border-width: 1px;
                                        border-color: root.export-format == f.id ? Theme.accent : Theme.border;
                                        background: format-touch.has-hover ? Theme.hover : transparent;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: f.label;
                                                color: Theme.text;
                                                font-size: Theme.font-size;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: f.detail;
                                                color: Theme.text-muted;
                                                font-size: Theme.font-size-small;
                                                horizontal-alignment: center;
                                            }
                                        }

                                        format-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.export-option("format", f.id);
                                            }
                                        }
                                    }
                                }

                                // The notes filter's colors; the export follows them.
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for c[i] in root.note-filters: Rectangle {
                                        height: 24px;
                                        width: chip-row.preferred-width + 16px;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: c.on ? Theme.text-muted : Theme.border;
                                        opacity: c.on ? 1 : 0.5;

                                        chip-row := HorizontalLayout {
                                            x: 8px;
                                            spacing: 6px;

                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: c.color;
                                            }
                                            Text {
                                                text: c.name;
                                                color: Theme.text;
                                                font-size: Theme.font-size-small;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.note-filter-clicked(i);
                                            }
                                        }
                                    }
                                }

                                if root.export-format == "markdown": HorizontalLayout {
                                    spacing: 10px;

                                    Toggle {
                                        checked: root.export-by-section;
                                        toggled => {
                                            root.export-option("by-section", root.export-by-section ? "false" : "true");
                                        }
                                    }
                                    Text {
                                        text: @tr("Group by outline section and color");
                                        color: Theme.text;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Rectangle {
                                    height: 180px;
                                    border-radius: Theme.radius;
                                    background: Theme.surface;
                                    clip: true;

                                    Text {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        text: root.export-ready ? root.export-preview : @tr("No notes in the chosen colors");
                                        color: Theme.text-muted;
                                        font-family: "Cascadia Mono, Consolas";
                                        font-size: Theme.font-size-small;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    Text {
                                        text: root.export-format == "anki" ? @tr("In Anki: File › Import. The note becomes the front, the quote the back.") : @tr("Enter to save · Esc to close");
                                        color: Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                    Button {
                                        text: @tr("Save…");
                                        primary: true;
                                        clicked => {
                                            root.export-accepted();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Note editor.
                    Panel {
                        visible: root.overlay == "note";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.15;
                        width: min(parent.width - 32px, 480px);
                        height: note-layout.preferred-height;

                        FocusScope {
                            capture-key-pressed(event) => {
                                if event.text == Key.Return && event.modifiers.control {
                                    root.note-saved();
                                    return accept;
                                }
                                reject
                            }

                            note-layout := VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "“" + root.note-quote + "”";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    font-italic: true;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: 60px;
                                }
                                Rectangle {
                                    height: 120px;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: note-input.has-focus ? Theme.accent : Theme.border;

                                    note-input := TextInput {
                                        x: 10px;
                                        y: 8px;
                                        width: parent.width - 20px;
                                        height: parent.height - 16px;
                                        color: Theme.text;
                                        font-size: Theme.font-size;
                                        selection-background-color: Theme.selection;
                                        wrap: word-wrap;
                                        single-line: false;
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: @tr("Ctrl+Enter to save · Esc to cancel");
                                        color: Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    TextButton {
                                        text: @tr("Save");
                                        active: true;
                                        clicked => {
                                            root.note-saved();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Command palette, near the top like Zed and VS Code.
        palette := Palette {
            visible: root.overlay == "palette";
            x: (parent.width - self.width) / 2;
            y: 60px;
            width: min(parent.width - 32px, 600px);
            items: root.palette-items;
            selected: root.palette-selected;
            placeholder: root.palette-placeholder;
            edited(text) => {
                root.palette-edited(text);
            }
            moved(delta) => {
                root.palette-moved(delta);
            }
            accepted => {
                root.palette-accepted();
            }
            item-clicked(i) => {
                root.palette-clicked(i);
            }
        }

        // Notification: "Downloading Leme…", "Copied". Quick ones clear
        // themselves from Rust; the rest stay until done or dismissed.
        if root.status != "": Panel {
            x: parent.width - self.width - Theme.spacing;
            y: parent.height - self.height - Theme.spacing;
            width: min(parent.width - 2 * Theme.spacing, 340px);
            height: toast-row.preferred-height;

            toast-row := HorizontalLayout {
                padding: 10px;
                padding-left: 12px;
                spacing: 10px;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
                Text {
                    text: root.status;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: Theme.radius;
                    background: close-touch.has-hover ? Theme.hover : transparent;

                    Icon {
                        name: "close";
                        width: 12px;
                        height: 12px;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.status = "";
                        }
                    }
                }
            }
        }
    }
}

// Settings live in their own window, so they can sit beside the document.
export component SettingsWindow inherits Window {
    title: @tr("Leme settings");
    icon: @image-url("../assets/icon.svg");
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    in-out property <string> section: "general";
    in property <[ThemeCard]> theme-cards;
    in property <string> theme-name;
    in property <string> page-colors;
    in property <[string]> font-options;
    in property <string> font-name;
    in property <int> font-size;
    in property <string> density;
    in property <string> corners;
    in property <string> thumbnail-size;
    in property <string> default-zoom;
    in property <bool> restore-session;
    in property <bool> sidebar-default;
    in property <bool> vim;
    in property <bool> study-timer;
    in property <[KeyRow]> key-rows;
    in property <[HighlightRow]> highlight-rows;
    in property <string> language;
    in property <[string]> language-options;
    in property <[color]> highlight-presets;
    in property <string> data-dir;
    in property <string> problems;
    in property <string> version;
    in-out property <string> query;
    in property <bool> show-general: true;
    in property <bool> show-reading: true;
    in property <bool> show-theme: true;
    in property <bool> show-appearance: true;
    in property <bool> show-keys: true;
    in property <bool> show-files: true;
    callback set(string, string);
    callback searched(string);
    callback close-requested();

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        SettingsView {
            section <=> root.section;
            query <=> root.query;
            theme-cards: root.theme-cards;
            show-general: root.show-general;
            show-reading: root.show-reading;
            show-theme: root.show-theme;
            show-appearance: root.show-appearance;
            show-keys: root.show-keys;
            show-files: root.show-files;
            theme: root.theme-name;
            page-colors: root.page-colors;
            font-options: root.font-options;
            font-name: root.font-name;
            font-size: root.font-size;
            density: root.density;
            corners: root.corners;
            thumbnail-size: root.thumbnail-size;
            default-zoom: root.default-zoom;
            restore-session: root.restore-session;
            sidebar: root.sidebar-default;
            vim: root.vim;
            study-timer: root.study-timer;
            keys: root.key-rows;
            highlights: root.highlight-rows;
            language: root.language;
            language-options: root.language-options;
            presets: root.highlight-presets;
            data-dir: root.data-dir;
            problems: root.problems;
            version: root.version;
            set(key, value) => {
                root.set(key, value);
            }
            searched(text) => {
                root.searched(text);
            }
            close => {
                root.close-requested();
            }
        }
    }
}
