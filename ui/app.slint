import { Theme } from "theme.slint";

component Sidebar inherits Rectangle {
    width: Theme.sidebar-width;
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        alignment: start;

        for i in 4: Rectangle {
            height: 120px;
            border-radius: 3px;
            background: Theme.page;
            border-width: 1px;
            border-color: Theme.border;
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
}

export struct PageView {
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    loaded: bool,
}

// Continuous strip of pages. Rust positions only the pages near the
// viewport, so long documents stay cheap.
component ReadingArea inherits Rectangle {
    in property <[PageView]> pages;
    in property <bool> has-document;
    in property <string> status;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> viewport-x;
    in-out property <length> viewport-y;

    background: Theme.background;

    Flickable {
        content-width: root.content-width;
        content-height: root.content-height;
        content-x <=> root.viewport-x;
        content-y <=> root.viewport-y;

        for page in root.pages: Rectangle {
            x: page.x;
            y: page.y;
            width: page.width;
            height: page.height;
            background: page.loaded ? transparent : Theme.surface;

            Image {
                width: parent.width;
                height: parent.height;
                source: page.image;
                image-fit: fill;
            }
        }
    }

    if !root.has-document: Text {
        text: root.status != "" ? root.status : "Open a PDF with Ctrl+O";
        color: Theme.text-muted;
        font-size: Theme.font-size;
    }
}

export component AppWindow inherits Window {
    title: "dpdf";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Theme.background;

    in-out property <bool> sidebar-visible: true;
    in property <string> document-title: "No document";
    in property <int> current-page: 0;
    in property <int> page-count: 0;

    in property <string> status;
    in property <[PageView]> pages;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> viewport-x;
    in-out property <length> viewport-y;
    out property <length> reader-width: reader.width;
    out property <length> reader-height: reader.height;

    callback scrolled();
    callback resized();
    changed viewport-y => { root.scrolled(); }
    changed reader-width => { root.resized(); }
    changed reader-height => { root.scrolled(); }

    // Raw key text and Ctrl state; Rust decides what it means.
    callback key-pressed(string, bool) -> bool;

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event.text, event.modifiers.control) ? accept : reject
        }

        VerticalLayout {
            // Header
            Rectangle {
                height: Theme.header-height;
                background: Theme.background;

                HorizontalLayout {
                    padding-left: Theme.spacing * 1.5;
                    padding-right: Theme.spacing * 1.5;
                    spacing: Theme.spacing;

                    Text {
                        text: root.document-title;
                        color: Theme.text;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.status != "" && root.page-count > 0 ? root.status
                            : root.page-count > 0 ? "page \{root.current-page} / \{root.page-count}" : "";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: "⚙";
                        color: Theme.text-muted;
                        font-size: Theme.font-size + 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                if root.sidebar-visible: Sidebar { }
                reader := ReadingArea {
                    pages: root.pages;
                    has-document: root.page-count > 0;
                    status: root.status;
                    content-width: root.content-width;
                    content-height: root.content-height;
                    viewport-x <=> root.viewport-x;
                    viewport-y <=> root.viewport-y;
                }
            }
        }
    }
}
