import { Theme } from "theme.slint";
import { PageView, ThumbView, RecentItem, TabItem, PaletteItem, KeyRow } from "structs.slint";
import { Panel, Field, TextButton } from "widgets.slint";
import { Sidebar, ReadingArea, StartScreen, TabBar } from "reader.slint";
import { Palette } from "palette.slint";
import { SettingsView } from "settings.slint";

export { Theme }
export { Highlight, Mark, PageView, ThumbView, RecentItem, TabItem, PaletteItem, KeyRow } from "structs.slint";

export component AppWindow inherits Window {
    title: root.page-count > 0 ? "\{root.document-title} — dpdf" : "dpdf";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Theme.background;

    // Chrome.
    in-out property <bool> sidebar-visible: true;
    in property <bool> fullscreen;
    in property <bool> focus-mode;
    in property <[TabItem]> tabs;
    in property <string> document-title;
    in property <int> current-page: 0;
    in property <int> page-count: 0;
    in property <string> status;
    in property <int> zoom-percent: 100;
    // "fit-width", "fit-page", or "custom".
    in property <string> zoom-mode: "fit-width";

    // Pages.
    in property <[PageView]> pages;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> viewport-x;
    in-out property <length> viewport-y;
    out property <length> reader-width: reader.width;
    out property <length> reader-height: reader.height;

    // Thumbnails.
    in property <[ThumbView]> thumbs;
    in property <length> thumbs-content-height;
    in-out property <length> thumbs-viewport-y;

    // Start screen.
    in property <[RecentItem]> recent;
    in property <int> session-tabs;

    // Overlays: "", "search", "goto", "palette", "settings", or "note".
    in property <string> overlay;
    in-out property <string> search-text <=> search-input.text;
    in property <string> search-status;
    in-out property <string> goto-text <=> goto-input.text;
    in property <[PaletteItem]> palette-items;
    in property <int> palette-selected;
    in-out property <string> palette-query <=> palette.query;
    in-out property <string> note-text <=> note-input.text;
    in property <string> note-quote;

    // Selection / annotation popup: "", "selection", or "annotation".
    in property <string> popup;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <[color]> annotation-colors;
    in property <bool> annotation-has-note;

    // Settings.
    in-out property <string> settings-section: "general";
    in property <[string]> theme-names;
    in property <string> theme-name;
    in property <string> page-colors;
    in property <string> default-zoom;
    in property <bool> restore-session;
    in property <bool> sidebar-default;
    in property <bool> vim;
    in property <[KeyRow]> key-rows;
    in property <string> data-dir;
    in property <string> problems;
    in property <string> version;

    // Raw key text and modifiers; Rust decides what it means.
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback scrolled();
    callback resized();
    callback thumbs-scrolled();
    callback thumb-clicked(int);
    callback open-recent(int);
    callback restore-session-clicked();
    callback search-edited(string);
    callback search-step(bool);
    callback goto-accepted(string);
    callback settings-clicked();
    // "in", "out", "fit-width", or "fit-page".
    callback zoom-action(string);
    callback tab-clicked(int);
    callback tab-closed(int);
    // "down", "move", or "up", in reader coordinates.
    callback reader-pointer(string, length, length);
    // "highlight" / "color" (with a color index), "underline", "strike",
    // "note", "copy", or "delete".
    callback popup-action(string, int);
    callback note-saved();
    callback palette-edited(string);
    callback palette-moved(int);
    callback palette-accepted();
    callback palette-clicked(int);
    callback settings-set(string, string);

    changed viewport-y => { root.scrolled(); }
    changed viewport-x => { root.scrolled(); }
    changed reader-width => { root.resized(); }
    changed reader-height => { root.resized(); }
    changed thumbs-viewport-y => { root.thumbs-scrolled(); }

    // Moves keyboard focus to the open overlay, or back to the reader.
    public function focus-overlay() {
        if root.overlay == "search" {
            search-input.focus();
            search-input.select-all();
        } else if root.overlay == "goto" {
            goto-input.focus();
            goto-input.select-all();
        } else if root.overlay == "palette" {
            palette.focus-input();
        } else if root.overlay == "note" {
            note-input.focus();
        } else {
            keys.focus();
        }
    }

    property <bool> chrome: !root.focus-mode && !root.fullscreen;

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }

        VerticalLayout {
            if root.chrome: Rectangle {
                height: Theme.header-height;
                background: Theme.background;

                HorizontalLayout {
                    padding-left: Theme.spacing * 0.75;
                    padding-right: Theme.spacing;
                    spacing: Theme.spacing;

                    if root.tabs.length > 0: TabBar {
                        horizontal-stretch: 1;
                        tabs: root.tabs;
                        clicked(i) => {
                            root.tab-clicked(i);
                        }
                        closed(i) => {
                            root.tab-closed(i);
                        }
                    }
                    if root.tabs.length == 0: Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.page-count > 0: HorizontalLayout {
                        spacing: 2px;
                        horizontal-stretch: 0;

                        TextButton {
                            y: (parent.height - self.height) / 2;
                            text: "Fit width";
                            active: root.zoom-mode == "fit-width";
                            clicked => {
                                root.zoom-action("fit-width");
                            }
                        }
                        TextButton {
                            y: (parent.height - self.height) / 2;
                            text: "Fit page";
                            active: root.zoom-mode == "fit-page";
                            clicked => {
                                root.zoom-action("fit-page");
                            }
                        }
                        Rectangle {
                            width: Theme.spacing;
                        }
                        TextButton {
                            y: (parent.height - self.height) / 2;
                            text: "−";
                            clicked => {
                                root.zoom-action("out");
                            }
                        }
                        Text {
                            text: "\{root.zoom-percent}%";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 44px;
                        }
                        TextButton {
                            y: (parent.height - self.height) / 2;
                            text: "+";
                            clicked => {
                                root.zoom-action("in");
                            }
                        }
                        Rectangle {
                            width: Theme.spacing;
                        }
                    }
                    Text {
                        text: root.page-count == 0 ? "" : root.status != "" ? root.status : "\{root.current-page} / \{root.page-count}";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }
                    TextButton {
                        y: (parent.height - self.height) / 2;
                        text: "⚙";
                        font-size: Theme.font-size + 2px;
                        clicked => {
                            root.settings-clicked();
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                if root.sidebar-visible && root.chrome && root.page-count > 0: Sidebar {
                    thumbs: root.thumbs;
                    current-page: root.current-page - 1;
                    content-height: root.thumbs-content-height;
                    viewport-y <=> root.thumbs-viewport-y;
                    clicked(page) => {
                        root.thumb-clicked(page);
                    }
                }

                reader := Rectangle {
                    ReadingArea {
                        pages: root.pages;
                        content-width: root.content-width;
                        content-height: root.content-height;
                        viewport-x <=> root.viewport-x;
                        viewport-y <=> root.viewport-y;
                    }

                    // Text selection, annotation clicks, and Ctrl+wheel zoom.
                    // Plain wheel events fall through to the page strip.
                    if root.page-count > 0: TouchArea {
                        mouse-cursor: text;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {
                                    root.reader-pointer("down", self.mouse-x, self.mouse-y);
                                } else if event.kind == PointerEventKind.up {
                                    root.reader-pointer("up", self.mouse-x, self.mouse-y);
                                }
                            }
                        }
                        moved => {
                            root.reader-pointer("move", self.mouse-x, self.mouse-y);
                        }
                        scroll-event(event) => {
                            if event.modifiers.control {
                                if event.delta-y != 0 {
                                    root.zoom-action(event.delta-y > 0 ? "in" : "out");
                                }
                                return accept;
                            }
                            reject
                        }
                    }

                    if root.page-count == 0: StartScreen {
                        recent: root.recent;
                        status: root.status;
                        session-tabs: root.session-tabs;
                        open-recent(i) => {
                            root.open-recent(i);
                        }
                        restore-session => {
                            root.restore-session-clicked();
                        }
                    }

                    // Selection toolbar, or the toolbar of a clicked annotation.
                    if root.popup != "": Panel {
                        x: max(8px, min(parent.width - self.width - 8px, root.popup-x - self.width / 2));
                        y: max(8px, root.popup-y - self.height - 8px);
                        width: popup-row.preferred-width;
                        height: 36px;

                        popup-row := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;

                            for c[i] in root.annotation-colors: Rectangle {
                                width: 26px;

                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: c;
                                    border-width: swatch.has-hover ? 2px : 0;
                                    border-color: Theme.text;
                                }

                                swatch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.popup-action(root.popup == "selection" ? "highlight" : "color", i);
                                    }
                                }
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.border;
                            }
                            TextButton {
                                text: "U̲";
                                clicked => {
                                    root.popup-action("underline", 0);
                                }
                            }
                            TextButton {
                                text: "S̶";
                                clicked => {
                                    root.popup-action("strike", 0);
                                }
                            }
                            TextButton {
                                text: root.popup == "annotation" && root.annotation-has-note ? "Edit note" : "Note";
                                clicked => {
                                    root.popup-action("note", 0);
                                }
                            }
                            TextButton {
                                text: "Copy";
                                clicked => {
                                    root.popup-action("copy", 0);
                                }
                            }
                            if root.popup == "annotation": TextButton {
                                text: "Delete";
                                clicked => {
                                    root.popup-action("delete", 0);
                                }
                            }
                        }
                    }

                    // Search: a small floating bar, top right.
                    Panel {
                        visible: root.overlay == "search";
                        x: parent.width - self.width - Theme.spacing;
                        y: Theme.spacing;
                        width: 320px;
                        height: 40px;

                        FocusScope {
                            // Enter / Shift+Enter step through matches.
                            capture-key-pressed(event) => {
                                if event.text == Key.Return {
                                    root.search-step(!event.modifiers.shift);
                                    return accept;
                                }
                                reject
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: Theme.spacing;

                                search-input := Field {
                                    horizontal-stretch: 1;
                                    edited => {
                                        root.search-edited(self.text);
                                    }
                                }
                                Text {
                                    text: root.search-status;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if search-input.text == "": Text {
                            x: 12px;
                            text: "Search";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                        }
                    }

                    // Jump to page: centered near the top.
                    Panel {
                        visible: root.overlay == "goto";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: 220px;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;

                            Text {
                                text: "Page";
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                            goto-input := Field {
                                horizontal-stretch: 1;
                                input-type: number;
                                accepted => {
                                    root.goto-accepted(self.text);
                                }
                            }
                            Text {
                                text: "/ \{root.page-count}";
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Note editor.
                    Panel {
                        visible: root.overlay == "note";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.15;
                        width: min(parent.width - 32px, 480px);
                        height: note-layout.preferred-height;

                        FocusScope {
                            capture-key-pressed(event) => {
                                if event.text == Key.Return && event.modifiers.control {
                                    root.note-saved();
                                    return accept;
                                }
                                reject
                            }

                            note-layout := VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "“" + root.note-quote + "”";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    font-italic: true;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: 60px;
                                }
                                Rectangle {
                                    height: 120px;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: note-input.has-focus ? Theme.accent : Theme.border;

                                    note-input := TextInput {
                                        x: 10px;
                                        y: 8px;
                                        width: parent.width - 20px;
                                        height: parent.height - 16px;
                                        color: Theme.text;
                                        font-size: Theme.font-size;
                                        selection-background-color: Theme.selection;
                                        wrap: word-wrap;
                                        single-line: false;
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: "Ctrl+Enter to save · Esc to cancel";
                                        color: Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    TextButton {
                                        text: "Save";
                                        active: true;
                                        clicked => {
                                            root.note-saved();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Settings: a large sheet over a dimmed window.
        if root.overlay == "settings": Rectangle {
            background: #00000066;

            TouchArea { }

            SettingsView {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 980px);
                height: min(parent.height - 48px, 720px);
                section <=> root.settings-section;
                theme-names: root.theme-names;
                theme: root.theme-name;
                page-colors: root.page-colors;
                default-zoom: root.default-zoom;
                restore-session: root.restore-session;
                sidebar: root.sidebar-default;
                vim: root.vim;
                keys: root.key-rows;
                data-dir: root.data-dir;
                problems: root.problems;
                version: root.version;
                set(key, value) => {
                    root.settings-set(key, value);
                }
                close => {
                    root.settings-clicked();
                }
            }
        }

        // Command palette, near the top like Zed and VS Code.
        palette := Palette {
            visible: root.overlay == "palette";
            x: (parent.width - self.width) / 2;
            y: 60px;
            width: min(parent.width - 32px, 600px);
            items: root.palette-items;
            selected: root.palette-selected;
            edited(text) => {
                root.palette-edited(text);
            }
            moved(delta) => {
                root.palette-moved(delta);
            }
            accepted => {
                root.palette-accepted();
            }
            item-clicked(i) => {
                root.palette-clicked(i);
            }
        }
    }
}
