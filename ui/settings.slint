import { Theme } from "theme.slint";
import { KeyRow, ThemeCard } from "structs.slint";
import { Toggle, Select, Button, TextButton, Field } from "widgets.slint";

// Line icons drawn as SVG paths on a 24x24 grid, so they don't depend on
// which symbol fonts are installed.
export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.text-muted;

    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    commands: root.name == "general" ? "M4 6h16 M4 12h16 M4 18h16 M9 4v4 M15 10v4 M7 16v4"
        : root.name == "reading" ? "M4 5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z M4 19V5 M8 7h8"
        : root.name == "theme" ? "M12 3a9 9 0 1 0 0.01 0z M12 3v18 M12 7h4 M12 11h6 M12 15h5"
        : root.name == "appearance" ? "M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z M12 9a3 3 0 1 0 0.01 0z"
        : root.name == "keys" ? "M3 6h18v12H3z M6.5 10h1 M10.5 10h1 M14.5 10h1 M7 14h10"
        : root.name == "file" ? "M6 2h9l5 5v15H6z M14 2v6h6 M9 13h6 M9 17h6"
        : root.name == "about" ? "M12 3a9 9 0 1 0 0.01 0z M12 11v6 M12 7.5v0.5"
        : root.name == "search" ? "M11 4a7 7 0 1 0 0.01 0z M20 20l-4-4"
        : "";
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent.with-alpha(0.16) : touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;

        Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            color: root.active ? Theme.accent : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component NavGroup inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-size-small;
    height: 28px;
    vertical-alignment: bottom;
    x: 10px;
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-size-large;
    font-weight: 600;
}

// A bordered group of rows.
component Card inherits Rectangle {
    border-radius: Theme.radius + 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    VerticalLayout {
        @children
    }
}

// One setting: title and description on the left, a control on the right.
component Row inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> last;

    min-height: 60px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: Theme.spacing * 2;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-size;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            @children
        }
    }

    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// Themes as cards painted in their own colors.
component ThemeGrid inherits Rectangle {
    in property <[ThemeCard]> themes;
    in property <string> current;
    callback picked(string);

    property <int> columns: root.width > 560px ? 3 : 2;
    property <length> gap: 10px;
    property <length> card-width: (root.width - 28px - (root.columns - 1) * root.gap) / root.columns;
    property <length> card-height: 50px;

    height: ceil(root.themes.length / root.columns) * (root.card-height + root.gap) - root.gap + 28px;
    border-radius: Theme.radius + 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    for theme[i] in root.themes: Rectangle {
        x: 14px + mod(i, root.columns) * (root.card-width + root.gap);
        y: 14px + floor(i / root.columns) * (root.card-height + root.gap);
        width: root.card-width;
        height: root.card-height;
        border-radius: Theme.radius + 2px;
        background: theme.background;
        border-width: theme.name == root.current ? 2px : 1px;
        border-color: theme.name == root.current ? Theme.accent : touch.has-hover ? Theme.text-muted : theme.border;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 5px;

            Text {
                text: theme.custom ? theme.name + "  ·  custom" : theme.name;
                color: theme.text;
                font-size: Theme.font-size;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            for dot in [theme.dot1, theme.dot2, theme.dot3]: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: dot;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.picked(theme.name);
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <string> section: "general";
    in property <[ThemeCard]> theme-cards;
    in property <string> theme;
    in property <string> page-colors;
    in property <string> default-zoom;
    in property <bool> restore-session;
    in property <bool> sidebar;
    in property <bool> vim;
    in property <[KeyRow]> keys;
    in property <string> data-dir;
    in property <string> problems;
    in property <string> version;
    // Which sections match the search box.
    in property <bool> show-general: true;
    in property <bool> show-reading: true;
    in property <bool> show-theme: true;
    in property <bool> show-appearance: true;
    in property <bool> show-keys: true;
    in property <bool> show-files: true;
    in-out property <string> query <=> search.text;
    // key/value pairs, or commands with an empty value.
    callback set(string, string);
    callback searched(string);
    callback close();

    background: Theme.background;

    HorizontalLayout {
        // Navigation.
        Rectangle {
            width: 230px;
            background: Theme.surface;

            VerticalLayout {
                padding: 12px;
                spacing: 2px;

                // Search.
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius + 2px;
                    border-width: 1px;
                    border-color: search.has-focus ? Theme.accent : Theme.border;
                    background: Theme.background;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "search";
                        }
                        search := Field {
                            horizontal-stretch: 1;
                            edited => {
                                root.searched(self.text);
                            }
                        }
                    }

                    if search.text == "": Text {
                        x: 36px;
                        text: "Search settings";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                    }
                }
                Rectangle {
                    height: 8px;
                }

                if root.show-general: NavItem {
                    text: "General";
                    icon: "general";
                    active: root.section == "general";
                    clicked => {
                        root.section = "general";
                    }
                }
                if root.show-reading: NavItem {
                    text: "Reading";
                    icon: "reading";
                    active: root.section == "reading";
                    clicked => {
                        root.section = "reading";
                    }
                }

                if root.show-theme || root.show-appearance: NavGroup {
                    text: "Visual";
                }
                if root.show-theme: NavItem {
                    text: "Theme";
                    icon: "theme";
                    active: root.section == "theme";
                    clicked => {
                        root.section = "theme";
                    }
                }
                if root.show-appearance: NavItem {
                    text: "Appearance";
                    icon: "appearance";
                    active: root.section == "appearance";
                    clicked => {
                        root.section = "appearance";
                    }
                }

                if root.show-keys || root.show-files: NavGroup {
                    text: "App";
                }
                if root.show-keys: NavItem {
                    text: "Keybindings";
                    icon: "keys";
                    active: root.section == "keys";
                    clicked => {
                        root.section = "keys";
                    }
                }
                if root.show-files: NavItem {
                    text: "Configuration files";
                    icon: "file";
                    active: root.section == "files";
                    clicked => {
                        root.section = "files";
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                // Version, which also opens About.
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius;
                    background: about.has-hover ? Theme.hover : transparent;

                    Text {
                        x: 10px;
                        text: "dpdf v\{root.version}";
                        color: root.section == "about" ? Theme.accent : Theme.text-muted;
                        font-size: Theme.font-size-small;
                    }

                    about := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.section = "about";
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        VerticalLayout {
            // Breadcrumb bar.
            Rectangle {
                height: 52px;

                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "Settings  /";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.section == "general" ? "General" : root.section == "reading" ? "Reading" : root.section == "theme" ? "Theme" : root.section == "appearance" ? "Appearance" : root.section == "keys" ? "Keybindings" : root.section == "files" ? "Configuration files" : "About";
                        color: Theme.text;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    TextButton {
                        y: (parent.height - self.height) / 2;
                        text: "Restore defaults";
                        clicked => {
                            root.set("reset", "");
                        }
                    }
                    TextButton {
                        y: (parent.height - self.height) / 2;
                        text: "×";
                        font-size: Theme.font-size-large;
                        clicked => {
                            root.close();
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            Flickable {
                content-height: body.preferred-height;

                body := VerticalLayout {
                    padding: 28px;
                    padding-top: 22px;
                    spacing: Theme.spacing;
                    alignment: start;

                    if root.problems != "": Rectangle {
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.match-current;
                        height: problem-text.preferred-height + 20px;

                        problem-text := Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: root.problems;
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                    }

                    if root.section == "general": VerticalLayout {
                        spacing: Theme.spacing;

                        SectionTitle {
                            text: "Session";
                        }
                        Card {
                            Row {
                                title: "Restore last session on startup";
                                description: "Reopen the tabs you had open, each at the page and zoom you left it.";
                                Toggle {
                                    checked: root.restore-session;
                                    toggled => {
                                        root.set("restore-session", root.restore-session ? "false" : "true");
                                    }
                                }
                            }
                            Row {
                                title: "Restore now";
                                description: "Bring back the tabs from the last session without restarting.";
                                last: true;
                                Button {
                                    text: "Restore";
                                    clicked => {
                                        root.set("restore-session-now", "");
                                    }
                                }
                            }
                        }
                    }

                    if root.section == "reading": VerticalLayout {
                        spacing: Theme.spacing;

                        SectionTitle {
                            text: "Layout";
                        }
                        Card {
                            Row {
                                title: "Default zoom";
                                description: "For documents you haven't opened before.";
                                Select {
                                    options: ["Fit width", "Fit page"];
                                    value: root.default-zoom;
                                    selected(value) => {
                                        root.set("default-zoom", value);
                                    }
                                }
                            }
                            Row {
                                title: "Thumbnail sidebar";
                                description: "Show page thumbnails next to the document.";
                                last: true;
                                Toggle {
                                    checked: root.sidebar;
                                    toggled => {
                                        root.set("sidebar", root.sidebar ? "false" : "true");
                                    }
                                }
                            }
                        }

                        SectionTitle {
                            text: "Keyboard";
                        }
                        Card {
                            Row {
                                title: "Vim keys";
                                description: "j/k scroll, gg/G first/last page, Ctrl+D/U half screen, / search, n/N matches, : command palette, y copy.";
                                last: true;
                                Toggle {
                                    checked: root.vim;
                                    toggled => {
                                        root.set("vim", root.vim ? "false" : "true");
                                    }
                                }
                            }
                        }
                    }

                    if root.section == "theme": VerticalLayout {
                        spacing: Theme.spacing;

                        SectionTitle {
                            text: "Theme";
                        }
                        ThemeGrid {
                            themes: root.theme-cards;
                            current: root.theme;
                            picked(name) => {
                                root.set("theme", name);
                            }
                        }

                        SectionTitle {
                            text: "Your themes";
                        }
                        Card {
                            Row {
                                title: "Reload themes";
                                description: "Reads .toml files from the themes folder. Copy any file from the repository's themes/ folder to start; missing colors fall back to a built-in theme.";
                                last: true;
                                HorizontalLayout {
                                    spacing: 6px;

                                    Button {
                                        text: "Open folder";
                                        clicked => {
                                            root.set("open-themes", "");
                                        }
                                    }
                                    Button {
                                        text: "Reload";
                                        clicked => {
                                            root.set("reload", "");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.section == "appearance": VerticalLayout {
                        spacing: Theme.spacing;

                        SectionTitle {
                            text: "Pages";
                        }
                        Card {
                            Row {
                                title: "Page colors";
                                description: "Inverted turns white pages dark, for reading at night.";
                                last: true;
                                Select {
                                    options: ["Original", "Inverted"];
                                    value: root.page-colors;
                                    selected(value) => {
                                        root.set("page-colors", value);
                                    }
                                }
                            }
                        }
                    }

                    if root.section == "keys": VerticalLayout {
                        spacing: Theme.spacing;

                        HorizontalLayout {
                            SectionTitle {
                                text: "Keybindings";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Edit in config.toml";
                                clicked => {
                                    root.set("open-config", "");
                                }
                            }
                        }
                        Text {
                            text: "Rebind any action under [keys] using the name on the right, e.g.  zoom-in = [\"ctrl+=\", \"z i\"]. An empty list unbinds it.";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                        Card {
                            for row[i] in root.keys: Rectangle {
                                height: 36px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: Theme.spacing;

                                    Text {
                                        text: row.title;
                                        color: Theme.text;
                                        font-size: Theme.font-size;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: row.keys != "" ? row.keys : "—";
                                        color: row.keys != "" ? Theme.text : Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        font-family: "Consolas";
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        width: 150px;
                                        text: row.name;
                                        color: Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        font-family: "Consolas";
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }

                                if i < root.keys.length - 1: Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Theme.border;
                                }
                            }
                        }
                    }

                    if root.section == "files": VerticalLayout {
                        spacing: Theme.spacing;

                        SectionTitle {
                            text: "Configuration files";
                        }
                        Card {
                            Row {
                                title: "config.toml";
                                description: "Every setting here, plus keybindings. Changes made in this window are written there too.";
                                HorizontalLayout {
                                    spacing: 6px;

                                    Button {
                                        text: "Open";
                                        clicked => {
                                            root.set("open-config", "");
                                        }
                                    }
                                    Button {
                                        text: "Reload";
                                        clicked => {
                                            root.set("reload", "");
                                        }
                                    }
                                }
                            }
                            Row {
                                title: "Data folder";
                                description: root.data-dir + "\nconfig.toml, themes, annotations, and reading history.";
                                last: true;
                                Button {
                                    text: "Open";
                                    clicked => {
                                        root.set("open-data-dir", "");
                                    }
                                }
                            }
                        }
                    }

                    if root.section == "about": VerticalLayout {
                        spacing: Theme.spacing;

                        SectionTitle {
                            text: "dpdf \{root.version}";
                        }
                        Card {
                            Row {
                                title: "A fast, minimal, local-first PDF reader";
                                description: "Built with Rust, Slint, and PDFium. MIT licensed.";
                            }
                            Row {
                                title: "Private by design";
                                description: "No telemetry, no accounts, no network access. Your notes, settings, and history stay in the data folder.";
                                last: true;
                            }
                        }
                    }
                }
            }
        }
    }
}
