import { Theme } from "theme.slint";
import { PageView, ThumbView, RecentItem, TabItem, SideItem, NoteFilter, SubjectItem } from "structs.slint";
import { Button, Icon, TextButton } from "widgets.slint";

// Page thumbnails, the outline, or the notes list. Rust positions only
// the thumbnails near the viewport.
export component Sidebar inherits Rectangle {
    in property <[ThumbView]> thumbs;
    in property <int> current-page;
    in property <length> content-height;
    in-out property <length> viewport-y;
    // "thumbs", "outline", or "notes".
    in property <string> mode;
    in property <[SideItem]> items;
    in property <[NoteFilter]> filters;
    // Outline progress, e.g. "4 of 9 sections", and its fraction.
    in property <string> progress-text;
    in property <float> progress;
    callback clicked(int);
    callback filter-clicked(int);
    callback status-clicked(int);
    callback mode-clicked(string);
    callback item-clicked(int);
    callback close-clicked();

    width: Theme.sidebar-width;
    background: Theme.surface;

    tabs := HorizontalLayout {
        y: 0;
        height: 32px;
        padding-left: 4px;
        padding-right: 4px;
        alignment: center;

        for tab in [{ id: "thumbs", label: @tr("Pages") }, { id: "outline", label: @tr("Outline") }, { id: "notes", label: @tr("Notes") }]: TextButton {
            y: (parent.height - self.height) / 2;
            text: tab.label;
            font-size: Theme.font-size-small;
            active: root.mode == tab.id;
            clicked => {
                root.mode-clicked(tab.id);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        TextButton {
            y: (parent.height - self.height) / 2;
            text: "×";
            clicked => {
                root.close-clicked();
            }
        }
    }

    if root.mode != "thumbs": Flickable {
        y: tabs.height;
        height: parent.height - tabs.height;
        content-width: self.width;
        content-height: list.preferred-height;

        list := VerticalLayout {
            width: parent.width;
            padding: 6px;
            alignment: start;

            if root.mode == "outline" && root.progress-text != "": VerticalLayout {
                padding: 6px;
                padding-bottom: 10px;
                spacing: 5px;

                HorizontalLayout {
                    Text {
                        text: root.progress-text;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "\{round(root.progress * 100)}%";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                    }
                }
                Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.border;

                    Rectangle {
                        x: 0;
                        width: parent.width * root.progress;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
            }

            // Which highlight colors the list shows.
            if root.mode == "notes": VerticalLayout {
                padding-bottom: 6px;

                for f[i] in root.filters: Rectangle {
                    height: 22px;
                    border-radius: Theme.radius;
                    background: filter-touch.has-hover ? Theme.hover : transparent;
                    opacity: f.on ? 1 : 0.45;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: f.color;
                        }
                        Text {
                            text: f.name;
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: f.count;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }
                    }

                    filter-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.filter-clicked(i);
                        }
                    }
                }
            }

            if root.items.length == 0: Text {
                text: root.mode == "outline" ? @tr("No outline") : root.filters.length > 0 ? @tr("No notes in these colors") : @tr("No notes yet");
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                horizontal-alignment: center;
            }
            for item[i] in root.items: Rectangle {
                height: row.preferred-height;
                border-radius: Theme.radius;
                background: touch.has-hover ? Theme.hover : transparent;

                row := HorizontalLayout {
                    padding: 5px;
                    padding-left: 6px + item.depth * 10px;
                    spacing: 6px;

                    if item.has-color: Rectangle {
                        width: 3px;
                        border-radius: 1.5px;
                        background: item.color;
                    }
                    if item.status >= 0: Rectangle {
                        width: 14px;
                        height: 14px;
                        y: 2px;
                        border-radius: 4px;
                        border-width: item.status == 0 ? 1px : 0;
                        border-color: status-touch.has-hover ? Theme.text-muted : Theme.border;
                        background: item.status == 0 ? transparent : item.status == 1 ? Theme.accent : Theme.accent.mix(Theme.text, 0.5);

                        Text {
                            text: item.status == 0 ? "" : item.status == 1 ? "✓" : item.status == 2 ? "2" : "3";
                            color: Theme.background;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        status-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.status-clicked(i);
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: item.title;
                            color: item.current ? Theme.accent : Theme.text;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                        if item.detail != "": Text {
                            text: item.detail;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                    }
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.item-clicked(i);
                    }
                }
            }
        }
    }

    if root.mode == "thumbs": Flickable {
        y: tabs.height;
        height: parent.height - tabs.height;
        content-height: root.content-height;
        content-y <=> root.viewport-y;

        for thumb in root.thumbs: Rectangle {
            x: thumb.x;
            y: thumb.y;
            width: thumb.width;
            height: thumb.height;
            background: thumb.loaded ? transparent : Theme.raised;

            Image {
                width: parent.width;
                height: parent.height;
                source: thumb.image;
                image-fit: fill;
            }

            // Selection ring drawn just outside the thumbnail.
            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 3px;
                border-width: 2px;
                border-color: thumb.page == root.current-page ? Theme.accent : transparent;
            }

            for dot[i] in thumb.dots: Rectangle {
                x: parent.width + 4px;
                y: 6px + i * 10px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: dot;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked(thumb.page);
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
}

// Continuous strip of pages. Rust positions only the pages near the
// viewport, so long documents stay cheap.
export component ReadingArea inherits Rectangle {
    in property <[PageView]> pages;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> viewport-x;
    in-out property <length> viewport-y;

    background: Theme.background;

    Flickable {
        content-width: root.content-width;
        content-height: root.content-height;
        content-x <=> root.viewport-x;
        content-y <=> root.viewport-y;

        for page in root.pages: Rectangle {
            x: page.x;
            y: page.y;
            width: page.width;
            height: page.height;
            background: page.loaded ? transparent : Theme.raised;

            Image {
                width: parent.width;
                height: parent.height;
                source: page.image;
                image-fit: fill;
            }

            for m in page.marks: Rectangle {
                x: parent.width * m.x;
                y: parent.height * m.y;
                width: parent.width * m.width;
                height: parent.height * m.height;

                // Highlight and selection: translucent fill.
                if m.kind == 0 || m.kind == 3: Rectangle {
                    background: m.kind == 3 ? Theme.selection : m.color.with-alpha(0.38);
                }
                // Underline.
                if m.kind == 1: Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: m.color;
                }
                // Strikethrough.
                if m.kind == 2: Rectangle {
                    y: parent.height * 0.52;
                    height: 2px;
                    background: m.color;
                }
                // Note marker.
                if m.note: Rectangle {
                    x: parent.width - 3px;
                    y: -5px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: m.color;
                    border-width: 1px;
                    border-color: #00000055;
                }
            }

            for h in page.highlights: Rectangle {
                x: parent.width * h.x;
                y: parent.height * h.y;
                width: parent.width * h.width;
                height: parent.height * h.height;
                background: h.current ? Theme.match-current : Theme.match;
            }
        }
    }
}

// Shown when no document is open: a hint, the last session, and recent files.
export component StartScreen inherits Rectangle {
    in property <[RecentItem]> recent;
    in property <string> status;
    in property <[RecentItem]> sessions;
    in property <string> session-name;
    // The session's documents and today's / this week's study time.
    in property <[SubjectItem]> subjects;
    in property <string> study-summary;
    callback open-subject(int);
    callback open-recent(int);
    callback open-session(int);
    callback new-session();

    background: Theme.background;

    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing * 2;
        width: min(parent.width - 64px, 460px);
        x: (parent.width - self.width) / 2;

        Text {
            text: root.status != "" ? root.status : @tr("Open a PDF with Ctrl+O, or press Ctrl+K for everything else");
            color: Theme.text-muted;
            font-size: Theme.font-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 2px;

            HorizontalLayout {
                Text {
                    text: @tr("Sessions");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: new-label.preferred-width + 12px;
                    height: 22px;
                    border-radius: Theme.radius;
                    background: new-touch.has-hover ? Theme.hover : transparent;

                    new-label := Text {
                        text: @tr("+ New session");
                        color: Theme.accent;
                        font-size: Theme.font-size-small;
                    }

                    new-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.new-session();
                        }
                    }
                }
            }

            for session[i] in root.sessions: Rectangle {
                height: 40px;
                border-radius: Theme.radius;
                background: session.title == root.session-name ? Theme.hover : session-touch.has-hover ? Theme.hover : transparent;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        name: "session";
                        color: session.title == root.session-name ? Theme.accent : Theme.text-muted;
                    }
                    Text {
                        text: session.title;
                        color: Theme.text;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: session.folder;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                    }
                }

                session-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-session(i);
                    }
                }
            }
        }

        if root.subjects.length > 0: VerticalLayout {
            spacing: 2px;

            HorizontalLayout {
                Text {
                    text: root.session-name;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.study-summary;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                }
            }

            for subject[i] in root.subjects: Rectangle {
                height: subject-layout.preferred-height;
                border-radius: Theme.radius;
                background: subject-touch.has-hover ? Theme.hover : transparent;

                subject-layout := VerticalLayout {
                    padding: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 5px;

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: subject.title;
                            color: Theme.text;
                            font-size: Theme.font-size;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if subject.has-progress: Text {
                            text: "\{round(subject.progress * 100)}%";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }
                    }
                    if subject.has-progress: Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.border;

                        Rectangle {
                            x: 0;
                            width: parent.width * subject.progress;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: subject.detail;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        overflow: elide;
                    }
                }

                subject-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-subject(i);
                    }
                }
            }
        }

        if root.recent.length > 0: VerticalLayout {
            spacing: 2px;

            Text {
                text: @tr("Recent");
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            for item[i] in root.recent: Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: touch.has-hover ? Theme.hover : transparent;

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Text {
                        text: item.title;
                        color: Theme.text;
                        font-size: Theme.font-size;
                        overflow: elide;
                    }
                    Text {
                        text: item.folder;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        overflow: elide;
                    }
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-recent(i);
                    }
                }
            }
        }
    }
}

// Document tabs, in the header.
export component TabBar inherits HorizontalLayout {
    in property <[TabItem]> tabs;
    callback clicked(int);
    callback closed(int);

    spacing: 2px;
    alignment: start;

    for tab[i] in root.tabs: Rectangle {
        height: 28px;
        y: (parent.height - self.height) / 2;
        max-width: 220px;
        min-width: 60px;
        preferred-width: tab-row.preferred-width;
        border-radius: Theme.radius;
        background: tab.active ? Theme.surface : touch.has-hover ? Theme.hover : transparent;
        border-width: tab.active ? 1px : 0;
        border-color: Theme.border;

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked(i);
            }
            pointer-event(event) => {
                // Middle click closes, like a browser.
                if event.button == PointerEventButton.middle && event.kind == PointerEventKind.up {
                    root.closed(i);
                }
            }
        }

        tab-row := HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            spacing: 6px;

            Icon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                name: "pdf";
                color: tab.active ? Theme.accent : Theme.text-muted;
            }
            Text {
                text: tab.title;
                color: tab.active ? Theme.text : Theme.text-muted;
                font-size: Theme.font-size;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 18px;
                border-radius: 4px;
                background: close.has-hover ? Theme.hover : transparent;
                opacity: tab.active || touch.has-hover || close.has-hover ? 1 : 0;

                Text {
                    text: "×";
                    color: Theme.text-muted;
                    font-size: Theme.font-size;
                }

                close := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.closed(i);
                    }
                }
            }
        }
    }
}
