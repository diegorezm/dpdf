// Data passed from Rust to the UI.

// A search match, as fractions of its page.
export struct Highlight {
    x: float,
    y: float,
    width: float,
    height: float,
    current: bool,
}

// One rect of an annotation or the selection, as fractions of its page.
// kind: 0 highlight, 1 underline, 2 strikethrough, 3 selection.
export struct Mark {
    x: float,
    y: float,
    width: float,
    height: float,
    kind: int,
    color: color,
    // Draw a note marker at this rect's end.
    note: bool,
}

export struct PageView {
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    loaded: bool,
    highlights: [Highlight],
    marks: [Mark],
}

export struct ThumbView {
    page: int,
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    loaded: bool,
    // Colors of the page's annotations, at most three.
    dots: [color],
}

// A row of the outline or notes panel.
export struct SideItem {
    title: string,
    detail: string,
    depth: int,
    color: color,
    has-color: bool,
    current: bool,
    // Outline progress: -1 no box, 0 unread, 1 read, 2 and 3 reviewed.
    status: int,
}

// A highlight color in Settings: its key in annotation files, the name
// the user gave it, and its shade.
export struct HighlightRow {
    key: string,
    name: string,
    color: color,
    hex: string,
}

// A highlight color in the notes filter.
export struct NoteFilter {
    name: string,
    color: color,
    count: int,
    on: bool,
}

export struct RecentItem {
    title: string,
    folder: string,
}

// A document of the current session, on the home screen.
export struct SubjectItem {
    title: string,
    detail: string,
    progress: float,
    has-progress: bool,
    active: bool,
}

export struct TabItem {
    title: string,
    active: bool,
}

export struct PaletteItem {
    title: string,
    detail: string,
    keys: string,
}

export struct KeyRow {
    title: string,
    name: string,
    keys: string,
}

// A theme as shown in the settings grid.
export struct ThemeCard {
    name: string,
    background: color,
    text: color,
    border: color,
    dot1: color,
    dot2: color,
    dot3: color,
    custom: bool,
}
